---
import qrCodeRaw from "../../public/qr-code.svg?raw";
import "../styles/schedule.css";

interface Props {
	title: string;
	qrTitle: string;
	description?: string;
	/** Path only, e.g. `/og.png` — becomes absolute using `site` */
	image?: string;
	keywords?: string[];
}

const {
	title,
	qrTitle,
	description = "Conference schedule",
	image,
	keywords = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = image ? new URL(image, Astro.site) : undefined;
const buildId = import.meta.env.PUBLIC_BUILD_ID;
const qrCodeSvg = qrCodeRaw.replace(/^<\?xml[^>]*>\s*/, "");
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: title,
	description,
	url: canonicalURL.href,
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="build-id" content={buildId} />
		<link rel="canonical" href={canonicalURL.href} />

		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		{keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
		<meta name="robots" content="index, follow" />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="fanfest.eve-online.tools" />
		<meta property="og:locale" content="en_US" />
		{imageURL && <meta property="og:image" content={imageURL.href} />}

		<meta name="twitter:card" content={imageURL ? "summary_large_image" : "summary"} />
		<meta name="twitter:url" content={canonicalURL.href} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{imageURL && <meta name="twitter:image" content={imageURL.href} />}

		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<script is:inline define:vars={{ buildId }}>
			window.setInterval(async () => {
				try {
					const res = await fetch(`/build.json?t=${Date.now()}`, {
						cache: "no-store",
					});
					if (!res.ok) return;

					const remote = await res.json();
					if (remote.id && remote.id !== buildId) {
						window.location.reload();
					}
				} catch {
					// Ignore transient offline/network failures.
				}
			}, 5 * 60 * 1000);
		</script>
	</head>
	<body class="schedule-body">
		<div class="schedule-bg" aria-hidden="true"></div>
		<slot />
		<footer class="site-footer" data-qr-open tabindex="0" role="button" aria-label="Show site QR code">
			Made by stroopwafels with ❤️
		</footer>
		<dialog class="qr-popup" id="qr-popup" aria-label="Site QR code">
			<h2 class="qr-popup__title">{qrTitle}</h2>
			<div class="qr-popup__code" aria-hidden="true" set:html={qrCodeSvg} />
			<p class="qr-popup__hint">Share this schedule by letting others scan this QR code</p>
		</dialog>
		<script is:inline>
			const qrPopup = document.getElementById("qr-popup");
			const qrOpen = document.querySelector("[data-qr-open]");

			if (qrPopup instanceof HTMLDialogElement && qrOpen instanceof HTMLElement) {
				const openQrPopup = () => {
					if (!qrPopup.open) qrPopup.showModal();
				};

				qrOpen.addEventListener("click", openQrPopup);
				qrOpen.addEventListener("keydown", (event) => {
					if (event.key !== "Enter" && event.key !== " ") return;
					event.preventDefault();
					openQrPopup();
				});
				qrPopup.addEventListener("click", () => qrPopup.close());
			}
		</script>
	</body>
</html>
